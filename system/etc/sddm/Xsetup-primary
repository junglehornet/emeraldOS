#!/usr/bin/python
"""Use the G27Q alone for SDDM's X11 greeter; leave user sessions alone."""
import re
import shutil
import subprocess
import sys

# Retain the distribution's display initialization.
subprocess.run(['/bin/sh', '/usr/share/sddm/scripts/Xsetup'], check=False)
xrandr = shutil.which('xrandr')
if not xrandr:
    print('SDDM monitor setup: xrandr is missing; keeping outputs enabled.', file=sys.stderr)
    sys.exit(0)
result = subprocess.run([xrandr, '--props'], capture_output=True, text=True)
if result.returncode:
    print('SDDM monitor setup: could not query outputs.', file=sys.stderr)
    sys.exit(0)
outputs = []
primary = None
for block in re.split(r'(?=^\S+ (?:connected|disconnected)\b)', result.stdout, flags=re.M):
    header = re.match(r'(\S+) connected\b', block)
    if not header:
        continue
    name = header[1]
    outputs.append(name)
    edid = re.search(r'^\s+EDID:\s*\n((?:[ \t]+[0-9a-fA-F]{32}[ \t]*\n)+)', block, re.M)
    if edid and b'G27Q' in bytes.fromhex(edid[1]):
        primary = name
# Never disable anything unless the intended primary was positively identified.
if primary is None:
    print('SDDM monitor setup: G27Q not found; keeping existing outputs.', file=sys.stderr)
    sys.exit(0)
command = [xrandr, '--output', primary, '--auto', '--primary', '--pos', '0x0']
for output in outputs:
    if output != primary:
        command += ['--output', output, '--off']
subprocess.run(command, check=False)
